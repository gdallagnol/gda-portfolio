<div class="glass-ribbon" id="glass-ribbon" aria-hidden="true"></div>

<style>
  .glass-ribbon { position: relative; width: 100%; aspect-ratio: 1; pointer-events: none; }
  /* O 3D entra com um fade suave assim que o primeiro quadro fica pronto. */
  .glass-ribbon :global(canvas) {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
    opacity: 0; transform: scale(0.97);
    transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .glass-ribbon.is-live :global(canvas) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .glass-ribbon :global(canvas) { transition: none; transform: none; }
  }
</style>

<script>
  // O 3D so existe em telas grandes; no celular e no tablet nada e baixado.
  const host = document.getElementById('glass-ribbon');
  const largeScreen = window.matchMedia('(min-width: 1280px)').matches;

  // Vidro do Sobre: so carrega quando estiver perto de entrar na tela.
  if (host && largeScreen) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const { mountSculpture } = await import('../lib/glassSculpture.js');
        mountSculpture(host, 'ribbon');
        requestAnimationFrame(() => requestAnimationFrame(() => host.classList.add('is-live')));
      },
      { rootMargin: '400px' }
    );
    io.observe(host);
  }
</script>