---
import arrow from '@assets/arrow.svg';
import Container from './Container.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/gabriela-dall-agnol' },
  { label: 'Behance', href: 'https://www.behance.net/gabrieladallagnol' },
  { label: 'Medium', href: 'https://medium.com/@gdallagnol' },
];
---

<footer class="bg-cold-gray text-white">
  <Container>
    <div class="flex flex-col py-10 gap-8 md:flex-row md:justify-between md:py-16">
      <div>
        <p class="text-2xl leading-8 mb-4 lg:text-4xl">{t('footer.cta')}</p>
        <div class="relative w-fit">
          <button class="copy-button text-white inline-block w-fit underline">contato@gdallagnol.com</button>
          <span
            class="copy-success-message top-full bg-white absolute left-1/2 transform -translate-x-1/2 mt-2 hidden text-sm text-green-600 border p-3 rounded-md shadow-md w-44"
          >
            {t('copy.success')}
          </span>
        </div>
      </div>

      <ul class="space-y-4 md:space-y-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="group flex justify-between md:gap-12">
                {link.label}
                <img
                  src={arrow.src}
                  alt=""
                  class="transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:-translate-y-1 group-focus-visible:translate-x-1 group-focus-visible:-translate-y-1 motion-reduce:transition-none"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>