---
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { CaseData } from '@i18n/cases/types';
import { productDesign, branding, type Project } from '@i18n/projects';

interface Props {
  data: CaseData;
  pageTitle?: string;
}

const { data, pageTitle } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { meta, blocks } = data;

const bullet = 'relative pl-6 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-cold-gray';
const headingClass = 'text-2xl text-cold-gray mb-6 md:basis-1/3 xl:basis-1/2';
const bodyClass = 'md:basis-2/3 xl:basis-1/2';
const newTab = lang === 'pt' ? 'abre em nova aba' : 'opens in a new tab';

// Descobre o proximo projeto da mesma categoria, a partir da URL atual.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const slug = segments[segments.length - 1];
const category = segments.includes('branding') ? branding : productDesign;
const published: Project[] = category.filter((p) => p.path);
const currentIndex = published.findIndex((p) => p.id === slug);
const next: Project | undefined =
  currentIndex >= 0 && published.length > 1 ? published[(currentIndex + 1) % published.length] : undefined;
const nextHref = next?.path ? (lang === 'pt' ? next.path : `/${lang}${next.path}`) : undefined;
---

<Layout
  title={pageTitle ?? `${meta.title} | Gabi Dall'Agnol`}
  description={meta.description ? meta.description[lang] : undefined}
>
  <Container>
    <!-- Ficha tecnica do projeto -->
    <section class="mb-12 flex flex-col gap-6 md:flex-row md:gap-16" aria-label={meta.title}>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg" id="lbl-segment">{t('case.segment')}</p>
        <p class="text-cold-gray text-lg">{meta.segment[lang]}</p>
      </div>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg">{t('case.client')}</p>
        <p class="text-cold-gray text-lg">{typeof meta.client === 'string' ? meta.client : meta.client[lang]}</p>
      </div>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg">{t('case.year')}</p>
        <p class="text-cold-gray text-lg">{meta.year}</p>
      </div>
      {
        meta.role && (
          <div>
            <p class="text-blue-gray mb-3 font-light text-lg">{t('case.role')}</p>
            <p class="text-cold-gray text-lg">{meta.role[lang]}</p>
          </div>
        )
      }
    </section>

    <main class="relative space-y-20 mb-24 md:mt-28">
      <div>
        <h1
          class="text-[2rem] leading-[2.8rem] text-cold-gray font-light md:text-[2.5rem] md:leading-[3.5rem] lg:text-[4rem] lg:leading-[5rem]"
        >
          {meta.title}
        </h1>
        {
          meta.subtitle && (
            <p class="text-[2rem] leading-[2.8rem] text-blue-gray font-light md:text-[2.5rem] md:leading-[3.5rem] lg:text-[4rem] lg:leading-[5rem]">
              {meta.subtitle[lang]}
              {meta.subtitleLink && (
                <a href={meta.subtitleLink.href} target="_blank" rel="noopener noreferrer" class="underline decoration-1 underline-offset-4 text-inherit hover:decoration-2">{meta.subtitleLink.label[lang]}<span class="sr-only"> ({newTab})</span></a>
              )}
              {meta.subtitleAfter && meta.subtitleAfter[lang]}
              {meta.subtitleNoWrap && <span class="sm:whitespace-nowrap">{meta.subtitleNoWrap[lang]}</span>}
            </p>
          )
        }
      </div>

      {
        blocks.map((block) => {
          if (block.type === 'image') {
            if (block.image.raw) {
              return <img src={block.image.src.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />;
            }
            return <Image src={block.image.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />;
          }

          if (block.type === 'captioned') {
            return (
              <section>
                <h2 class="text-2xl text-cold-gray mb-6">{block.heading[lang]}</h2>
                <Image src={block.image.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
              </section>
            );
          }

          if (block.type === 'gallery') {
            return (
              <div class="space-y-14 overflow-clip">
                {block.images.map((img) => (
                  <Image src={img.src} alt={img.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
                ))}
              </div>
            );
          }

          if (block.type === 'carousel') {
            // Faixa que rola sozinha. A lista e duplicada para o laco ser continuo.
            return (
              <div class="case-marquee -mx-6 lg:-mx-14 2xl:-mx-36" role="group" aria-label={meta.title}>
                <div class="case-marquee__track">
                  {[0, 1].map((copy) =>
                    block.images.map((img) => (
                      <Image
                        src={img.src}
                        alt={copy === 0 ? img.alt[lang] : ''}
                        aria-hidden={copy === 1 ? 'true' : undefined}
                        class="case-marquee__item rounded-3xl"
                        loading="lazy"
                      />
                    ))
                  )}
                </div>
              </div>
            );
          }

          if (block.type === 'pair') {
            return (
              <div class="flex gap-6 justify-center">
                {block.images.map((img) => (
                  <Image
                    src={img.src}
                    alt={img.alt[lang]}
                    class="rounded-3xl w-1/2 h-auto object-cover overflow-hidden"
                    loading="lazy"
                    data-reveal
                  />
                ))}
              </div>
            );
          }

          if (block.type === 'text') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <h2 class={headingClass}>{block.heading[lang]}</h2>
                  <div class={`space-y-6 ${bodyClass}`}>
                    {block.paragraphs[lang].map((p) => (
                      <p class="text-cold-gray leading-7">{p}</p>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'list') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <h2 class={headingClass}>{block.heading[lang]}</h2>
                  <div class={bodyClass}>
                    {block.intro && <p class="text-cold-gray leading-7">{block.intro[lang]}</p>}
                    {block.groups.map((group) => (
                      <div>
                        {group.subhead && <h3 class="text-xl text-cold-gray mt-10 mb-6">{group.subhead[lang]}</h3>}
                        <ul class="text-cold-gray leading-7 space-y-8">
                          {group.items[lang].map((item) => (
                            <li class={bullet}>{item}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'objectives') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <h2 class={headingClass}>{block.heading[lang]}</h2>
                  <div class={`space-y-6 ${bodyClass}`}>
                    {block.items.map((item) => (
                      <div>
                        <h3 class="text-xl text-cold-gray mb-4">
                          <span aria-hidden="true">{item.icon}</span> {item.title[lang]}
                        </h3>
                        <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'simple') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between md:gap-4">
                  <h2 class={headingClass}>{block.heading[lang]}</h2>
                  <ul class={`space-y-8 ${bodyClass}`}>
                    {block.items.map((item) => (
                      <li class="text-cold-gray leading-7">{item[lang]}</li>
                    ))}
                  </ul>
                </div>
              </section>
            );
          }

          return null;
        })
      }
    </main>

    {
      next && nextHref && (
        <nav class="mb-24 border-t border-blue-gray/20 pt-10" aria-label={t('case.next')}>
          <a href={nextHref} class="group flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <span>
              <span class="text-blue-gray font-light text-lg block mb-2">{t('case.next')}</span>
              <span class="text-cold-gray text-2xl font-light md:text-4xl">{next.headline[lang]}</span>
            </span>
            <span
              aria-hidden="true"
              class="flex h-11 w-16 shrink-0 items-center justify-center rounded-full bg-cold-gray text-white transition-[width] duration-300 ease-out group-hover:w-11 motion-reduce:transition-none"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </nav>
      )
    }
  </Container>
</Layout>

<style>
  .case-marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 4rem, black calc(100% - 4rem), transparent);
  }

  .case-marquee__track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: case-marquee 60s linear infinite;
  }

  .case-marquee:hover .case-marquee__track {
    animation-play-state: paused;
  }

  .case-marquee__item {
    height: 22rem;
    width: auto;
    max-width: none;
    flex-shrink: 0;
  }

  @keyframes case-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* metade do percurso, porque a lista aparece duas vezes */
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .case-marquee__track {
      animation: none;
    }
  }
</style>
