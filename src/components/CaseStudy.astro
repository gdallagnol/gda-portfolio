---
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { CaseBlock, CaseData, T } from '@i18n/cases/types';
import { productDesign, branding, type Project } from '@i18n/projects';

interface Props {
  data: CaseData;
  pageTitle?: string;
}

const { data, pageTitle } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { meta, blocks } = data;

const bullet = 'relative pl-6 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-cold-gray';
// Escala tipografica do case, do maior para o menor nivel:
// 1. Titulo da pagina (h1), definido no topo.
// 2. Titulo de secao: 1,5rem no celular, 1,75rem a partir do tablet.
// 3. Frase de destaque (pergunta orientadora, achados): 1,25rem a 1,375rem, peso leve.
// 4. Titulo de item (etapas, decisoes, grupos de telas, cards): 1,125rem.
// 5. Texto corrido: 1rem. 6. Rotulos e legendas: 0,875rem.
// Numeros de dados usam um tamanho proprio (3rem), fora da hierarquia de titulos.
const sectionTitle = 'text-2xl leading-8 md:text-[1.75rem] md:leading-9 text-cold-gray';
const headingClass = `${sectionTitle} mb-6 md:basis-1/3 xl:basis-1/2`;
const statementClass = 'text-xl leading-8 md:text-[1.375rem] md:leading-9 font-light text-cold-gray';
const itemTitle = 'text-lg leading-7 text-cold-gray';
const dataValue = 'text-5xl font-light';
// max-w-[68ch] mantem a linha abaixo de ~75 caracteres, faixa confortavel de leitura
const bodyClass = 'md:basis-2/3 xl:basis-1/2 max-w-[68ch]';
// Rotulos curtos (numeros, categorias, legendas)
const eyebrow = 'text-sm text-blue-gray font-light tracking-wide';
const newTab = lang === 'pt' ? 'abre em nova aba' : 'opens in a new tab';
const screenLabel = lang === 'pt' ? 'Tela' : 'Screen';
const enlarge = lang === 'pt' ? 'ampliar imagem' : 'enlarge image';

// Numera itens como 01, 02, 03.
const num = (i: number) => String(i + 1).padStart(2, '0');
const tr = (v: string | T) => (typeof v === 'string' ? v : v[lang]);

// Descobre o proximo projeto da mesma categoria, a partir da URL atual.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const slug = segments[segments.length - 1];
const category = segments.includes('branding') ? branding : productDesign;
const published: Project[] = category.filter((p) => p.path);
const currentIndex = published.findIndex((p) => p.id === slug);
const next: Project | undefined =
  currentIndex >= 0 && published.length > 1 ? published[(currentIndex + 1) % published.length] : undefined;
// Projeto anterior, em ciclo. Com apenas dois projetos, anterior e proximo seriam o mesmo, entao so o proximo aparece.
const prevCandidate: Project | undefined =
  currentIndex >= 0 && published.length > 2
    ? published[(currentIndex - 1 + published.length) % published.length]
    : undefined;
const prev = prevCandidate && prevCandidate.id !== next?.id ? prevCandidate : undefined;
const hrefFor = (p: Project) => (lang === 'pt' ? p.path! : `/${lang}${p.path}`);
const prevLabel = lang === 'pt' ? 'Projeto anterior' : 'Previous project';
const navLabel = lang === 'pt' ? 'Outros projetos' : 'More projects';
// Ordem no celular: proximo primeiro.
const neighbours = [
  ...(next ? [{ p: next, label: t('case.next'), dir: 'next' as const }] : []),
  ...(prev ? [{ p: prev, label: prevLabel, dir: 'prev' as const }] : []),
];

// Numeracao continua das telas dentro de cada bloco "screens".
let screenCounter = 0;

// A primeira imagem do case e a capa: carrega logo e ja aparece visivel.
let coverDone = false;

// Capitulos: geram o indice do resumo e rebaixam os titulos de secao para h3.
const chapters = blocks.filter((b): b is Extract<CaseBlock, { type: 'chapter' }> => b.type === 'chapter');
const Hs = chapters.length > 0 ? 'h3' : 'h2';
const chapterLabel = lang === 'pt' ? 'Capítulo' : 'Chapter';
const indexLabel = lang === 'pt' ? 'Neste case' : 'In this case study';
// Icones Feather (feathericons.com, licenca MIT), desenhados em linha para nao depender de biblioteca.
const featherIcons: Record<string, string> = {
  layers:
    '<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>',
  layout:
    '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line>',
  target: '<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>',
  'trending-up': '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline>',
  users:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
  'user-check':
    '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline>',
};
const pauseLabel = lang === 'pt' ? 'Pausar animação' : 'Pause animation';
const playLabel = lang === 'pt' ? 'Retomar animação' : 'Resume animation';
const insightLabel = lang === 'pt' ? 'Achado' : 'Finding';
const toolsLabel = lang === 'pt' ? 'Ferramentas' : 'Tools';
const backToTopLabel = lang === 'pt' ? 'Voltar ao topo' : 'Back to top';
---

<Layout
  title={pageTitle ?? `${meta.title} | Gabi Dall'Agnol`}
  description={meta.description ? meta.description[lang] : undefined}
>
  <!-- Barra fina de progresso de leitura (so CSS, sem JavaScript) -->
  <div class="read-progress" aria-hidden="true"></div>

  <Container>
    <!-- Ficha tecnica do projeto -->
    <section class="mb-12 flex flex-col gap-6 md:flex-row md:flex-wrap md:gap-x-16 md:gap-y-6" aria-label={meta.title}>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg" id="lbl-segment">{t('case.segment')}</p>
        <p class="text-cold-gray text-lg">{meta.segment[lang]}</p>
      </div>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg">{t('case.client')}</p>
        <p class="text-cold-gray text-lg">{typeof meta.client === 'string' ? meta.client : meta.client[lang]}</p>
      </div>
      <div>
        <p class="text-blue-gray mb-3 font-light text-lg">{t('case.year')}</p>
        <p class="text-cold-gray text-lg">{meta.year}</p>
      </div>
      {
        meta.role && (
          <div>
            <p class="text-blue-gray mb-3 font-light text-lg">{t('case.role')}</p>
            <p class="text-cold-gray text-lg">{meta.role[lang]}</p>
          </div>
        )
      }
      {
        meta.tools && (
          <div>
            <p class="text-blue-gray mb-3 font-light text-lg">{toolsLabel}</p>
            <p class="text-cold-gray text-lg">{meta.tools.join(', ')}</p>
          </div>
        )
      }
    </section>

    <main class="relative space-y-20 mb-24 md:mt-28">
      <div>
        <h1
          id="case-top"
          tabindex="-1"
          class="text-[2rem] leading-[2.8rem] text-cold-gray font-light focus:outline-none md:text-[2.5rem] md:leading-[3.5rem] lg:text-[4rem] lg:leading-[5rem]"
        >
          {meta.title}
        </h1>
        {
          meta.subtitle && (
            <p class="text-[2rem] leading-[2.8rem] text-blue-gray font-light md:text-[2.5rem] md:leading-[3.5rem] lg:text-[4rem] lg:leading-[5rem]">
              {meta.subtitle[lang]}
              {meta.subtitleLink && (
                <a href={meta.subtitleLink.href} target="_blank" rel="noopener noreferrer" class="underline decoration-1 underline-offset-4 text-inherit hover:decoration-2">{meta.subtitleLink.label[lang]}<span class="sr-only"> ({newTab})</span></a>
              )}
              {meta.subtitleAfter && meta.subtitleAfter[lang]}
              {meta.subtitleNoWrap && <span class="sm:whitespace-nowrap">{meta.subtitleNoWrap[lang]}</span>}
            </p>
          )
        }
      </div>

      {
        blocks.map((block) => {
          if (block.type === 'image') {
            const isCover = !coverDone;
            coverDone = true;
            if (isCover) {
              const cover = block.image.raw ? (
                <img src={block.image.src.src} alt={block.image.alt[lang]} class="rounded-3xl" />
              ) : (
                <Image src={block.image.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="eager" />
              );
              if (!block.image.caption) return cover;
              return (
                <figure>
                  {cover}
                  <figcaption class="mt-4 max-w-[60ch] text-sm leading-6 text-blue-gray">{block.image.caption[lang]}</figcaption>
                </figure>
              );
            }
            const img = block.image.raw ? (
              <img src={block.image.src.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
            ) : (
              <Image src={block.image.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
            );
            if (!block.image.caption) return img;
            return (
              <figure>
                {img}
                <figcaption class="mt-4 max-w-[60ch] text-sm leading-6 text-blue-gray">{block.image.caption[lang]}</figcaption>
              </figure>
            );
          }

          if (block.type === 'captioned') {
            return (
              <section>
                <h2 class={`${sectionTitle} mb-6`}>{block.heading[lang]}</h2>
                <Image src={block.image.src} alt={block.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
              </section>
            );
          }

          if (block.type === 'gallery') {
            return (
              <div class="space-y-14 overflow-clip">
                {block.images.map((img) =>
                  img.caption ? (
                    <figure>
                      <Image src={img.src} alt={img.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
                      <figcaption class="mt-4 max-w-[60ch] text-sm leading-6 text-blue-gray">{img.caption[lang]}</figcaption>
                    </figure>
                  ) : (
                    <Image src={img.src} alt={img.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
                  )
                )}
              </div>
            );
          }

          if (block.type === 'video') {
            // Substitui GIF: mesmo comportamento visual, fracao do peso.
            return (
              <video
                src={block.src}
                loop
                muted
                playsinline
                preload="metadata"
                aria-label={block.alt[lang]}
                class="w-full rounded-3xl"
                data-auto-video
              />
            );
          }

          if (block.type === 'carousel') {
            // Faixa em laco continuo. A lista aparece duas vezes para o loop nao ter emenda.
            return (
              <div>
              <div class="case-marquee -mx-6 lg:-mx-14 2xl:-mx-36" role="group" aria-label={meta.title} tabindex="0" data-marquee>
                <div class="case-marquee__track">
                  {[0, 1].map((copia) =>
                    block.images.map((img) => (
                      <Image
                        src={img.src}
                        alt={copia === 0 ? img.alt[lang] : ''}
                        aria-hidden={copia === 1 ? 'true' : undefined}
                        class="case-marquee__item rounded-3xl"
                        loading="lazy"
                      />
                    ))
                  )}
                </div>
              </div>
              <button
                type="button"
                class="mt-4 inline-flex items-center gap-2 rounded-full border border-cold-gray/25 px-4 py-2 text-sm text-cold-gray hover:bg-lilac-blue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cold-gray motion-reduce:hidden"
                aria-pressed="false"
                data-marquee-toggle
                data-label-pause={pauseLabel}
                data-label-play={playLabel}
              >
                {pauseLabel}
              </button>
              </div>
            );
          }

          if (block.type === 'pair') {
            return (
              <div class="flex gap-6 justify-center">
                {block.images.map((img) => (
                  <Image
                    src={img.src}
                    alt={img.alt[lang]}
                    class="rounded-3xl w-1/2 h-auto object-cover overflow-hidden"
                    loading="lazy"
                    data-reveal
                  />
                ))}
              </div>
            );
          }

          if (block.type === 'text') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={`space-y-6 ${bodyClass}`}>
                    {block.paragraphs[lang].map((p) => (
                      <p class="text-cold-gray leading-7">{p}</p>
                    ))}
                    {block.link && (
                      <p>
                        <a
                          href={lang === 'pt' ? block.link.href : `/${lang}${block.link.href}`}
                          class="text-cold-gray underline decoration-1 underline-offset-4 hover:decoration-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cold-gray"
                        >
                          {block.link.label[lang]}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'list') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={bodyClass}>
                    {block.intro && <p class="text-cold-gray leading-7">{block.intro[lang]}</p>}
                    {block.groups.map((group) => (
                      <div>
                        {group.subhead && <h3 class={`${itemTitle} mt-10 mb-6`}>{group.subhead[lang]}</h3>}
                        <ul class="text-cold-gray leading-7 space-y-8">
                          {group.items[lang].map((item) => (
                            <li class={bullet}>{item}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'objectives') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={`space-y-6 ${bodyClass}`}>
                    {block.items.map((item, i) => (
                      <div>
                        <h3 class={`${itemTitle} mb-3`}>
                          {item.icon ? (
                            <span aria-hidden="true">{item.icon}</span>
                          ) : (
                            <span class="text-blue-gray font-light mr-2">{num(i)}</span>
                          )}{' '}
                          {item.title[lang]}
                        </h3>
                        <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'simple') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between md:gap-4">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <ul class={`space-y-8 ${bodyClass}`}>
                    {block.items.map((item) => (
                      <li class="text-cold-gray leading-7">{item[lang]}</li>
                    ))}
                  </ul>
                </div>
              </section>
            );
          }

          // Resumo do projeto: leitura de 30 segundos logo apos a imagem principal.
          if (block.type === 'summary') {
            return (
              <section class="rounded-3xl bg-lilac-blue px-6 py-10 md:px-12 md:py-14">
                <h2 class={`${sectionTitle} mb-10`}>{block.heading[lang]}</h2>
                <div class="grid gap-10 md:grid-cols-3 md:gap-12">
                  {block.items.map((item) => (
                    <div>
                      <h3 class={`${eyebrow} mb-3`}>{item.label[lang]}</h3>
                      <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                    </div>
                  ))}
                </div>
                {block.facts && (
                  <ul class="mt-12 grid items-start gap-8 sm:grid-cols-3">
                    {block.facts.map((fact) => (
                      <li class="flex flex-col gap-2">
                        <p class={`${dataValue} text-cold-gray`}>{tr(fact.value)}</p>
                        <p class="text-blue-gray leading-6">{fact.label[lang]}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {chapters.length > 0 && (
                  <nav class="mt-12" aria-label={indexLabel}>
                    <p class={`${eyebrow} mb-4`}>{indexLabel}</p>
                    <ol class="flex flex-wrap gap-2">
                      {chapters.map((c, ci) => (
                        <li>
                          <a
                            href={`#${c.id}`}
                            class="inline-flex items-center gap-2 rounded-full bg-[#FAFAFF] px-4 py-2 text-sm text-cold-gray transition-colors hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cold-gray motion-reduce:transition-none"
                          >
                            <span class="text-blue-gray">{num(ci)}</span>
                            {c.heading[lang]}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                )}
              </section>
            );
          }

          // Frase em destaque, alinhada a coluna de texto.
          if (block.type === 'highlight') {
            return (
              <div class="flex flex-col md:flex-row md:justify-between">
                <div class="hidden md:block md:basis-1/3 xl:basis-1/2" aria-hidden="true" />
                <div class={`border-l-2 border-cold-gray pl-6 ${bodyClass}`}>
                  {block.label && <p class={`${eyebrow} mb-3`}>{block.label[lang]}</p>}
                  <p class={statementClass}>{block.text[lang]}</p>
                </div>
              </div>
            );
          }

          // Dados de mercado: numero grande, texto e fonte, em largura total.
          if (block.type === 'stats') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  {block.intro && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{block.intro[lang]}</p>}
                </div>
                <ul class="mt-10 grid gap-3 md:grid-cols-2">
                  {block.items.map((item) => (
                    <li class="rounded-3xl bg-lilac-blue p-8 md:p-10">
                      <p class={`mb-4 ${dataValue} text-cold-gray`}>{tr(item.value)}</p>
                      <p class="max-w-[48ch] text-cold-gray leading-7">{item.text[lang]}</p>
                      {item.source && <p class="mt-4 text-sm text-blue-gray">{tr(item.source)}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            );
          }

          // Abertura de capitulo: marca as quatro partes do case.
          if (block.type === 'chapter') {
            const ci = chapters.indexOf(block);
            return (
              <section id={block.id} class="scroll-mt-24 pt-6 md:pt-12" aria-labelledby={`${block.id}-title`}>
                <div class="flex items-baseline gap-4">
                  <span class="text-sm text-blue-gray font-light tracking-wide" aria-hidden="true">{num(ci)}</span>
                  <h2 id={`${block.id}-title`} class={sectionTitle}>
                    <span class="sr-only">{chapterLabel} {num(ci)}: </span>
                    {block.heading[lang]}
                  </h2>
                </div>
                {block.text && <p class="mt-4 max-w-[60ch] text-blue-gray leading-7">{block.text[lang]}</p>}
              </section>
            );
          }

          // Achados principais: frases grandes na coluna de conteudo.
          if (block.type === 'insights') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={bodyClass}>
                    {block.intro && <p class="text-cold-gray leading-7 mb-12">{block.intro[lang]}</p>}
                    <ul class="space-y-3">
                      {block.items.map((item, i) => (
                        <li class="rounded-3xl bg-lilac-blue p-8">
                          <p class={`${eyebrow} mb-2`}>{insightLabel} {num(i)}</p>
                          <h3 class={`${itemTitle} mb-3`}>{item.title[lang]}</h3>
                          <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </section>
            );
          }

          // Blocos curtos lado a lado; empilham no celular.
          if (block.type === 'cards') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  {block.intro && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{block.intro[lang]}</p>}
                </div>
                <ul class="mt-10 grid gap-3 md:grid-cols-3">
                  {block.items.map((item) => (
                    <li class="rounded-3xl bg-lilac-blue p-8">
                      <p class={`${eyebrow} mb-3`}>{item.label[lang]}</p>
                      <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                    </li>
                  ))}
                </ul>
              </section>
            );
          }

          // Resultado: fluxo em linha (vertical no celular) e desdobramentos em cards.
          if (block.type === 'outcome') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  {block.intro && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{block.intro[lang]}</p>}
                </div>
                <ol class="mt-10 flex flex-col items-stretch gap-2 md:flex-row md:items-center md:gap-3">
                  {block.flow.map((step, fi) => (
                    <li class="flex flex-col items-center gap-2 md:flex-1 md:flex-row md:gap-3">
                      {fi > 0 && (
                        <span aria-hidden="true" class="text-blue-gray">
                          <span class="md:hidden">↓</span>
                          <span class="hidden md:inline">→</span>
                        </span>
                      )}
                      <span class="w-full rounded-full border border-cold-gray/25 px-5 py-3 text-center text-sm text-cold-gray md:flex-1">
                        {step[lang]}
                      </span>
                    </li>
                  ))}
                </ol>
                <div class="mt-3 grid gap-3 md:grid-cols-2">
                  {block.items.map((item) => (
                    <article class="rounded-3xl bg-lilac-blue p-8 md:p-10">
                      {item.tag && (
                        <p class="mb-4">
                          <span class="rounded-full border border-cold-gray/25 px-3 py-0.5 text-xs text-blue-gray">{item.tag[lang]}</span>
                        </p>
                      )}
                      <h3 class={`mb-3 ${itemTitle}`}>{item.title[lang]}</h3>
                      <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                    </article>
                  ))}
                </div>
              </section>
            );
          }

          // Itens numerados na coluna de conteudo, alinhados ao texto das outras secoes.
          if (block.type === 'steps' && block.layout === 'grid') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  {block.intro && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{block.intro[lang]}</p>}
                </div>
                <ol class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {block.items.map((item, i) => (
                    <li class="flex flex-col rounded-3xl bg-lilac-blue p-8">
                      <p class={`${eyebrow} mb-4 flex flex-wrap items-center gap-3`}>
                        {block.numbered !== false && <span>{num(i)}</span>}
                        {item.tag && (
                          <span class="rounded-full border border-cold-gray/25 px-3 py-0.5 text-xs">{item.tag[lang]}</span>
                        )}
                      </p>
                      <h3 class={`mb-2 ${itemTitle}`}>{item.title[lang]}</h3>
                      <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                    </li>
                  ))}
                </ol>
              </section>
            );
          }

          if (block.type === 'steps') {
            const hasEmphasis = block.items.some((it) => it.emphasis);
            const listClass = hasEmphasis
              ? 'space-y-3'
              : `grid gap-x-10 gap-y-10 ${block.columns === 2 ? 'sm:grid-cols-2' : ''}`;
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={bodyClass}>
                    {block.intro && <p class="text-cold-gray leading-7 mb-10">{block.intro[lang]}</p>}
                    <ol class={listClass}>
                      {block.items.map((item, i) => (
                        <li class={`${item.emphasis ? 'rounded-3xl bg-lilac-blue p-8' : hasEmphasis ? 'px-8' : ''} `}>
                          {item.icon && featherIcons[item.icon] && (
                            <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-lilac-blue text-cold-gray" aria-hidden="true">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                set:html={featherIcons[item.icon]}
                              />
                            </span>
                          )}
                          <div>
                          {(block.numbered !== false || item.tag) && (
                            <p class={`${eyebrow} mb-2 flex flex-wrap items-center gap-3`}>
                              {block.numbered !== false && <span>{num(i)}</span>}
                              {item.tag && (
                                <span class="rounded-full border border-cold-gray/25 px-3 py-0.5 text-xs">{item.tag[lang]}</span>
                              )}
                            </p>
                          )}
                          <h3 class={`mb-2 ${itemTitle}`}>{item.title[lang]}</h3>
                          <p class="text-cold-gray leading-7">{item.text[lang]}</p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </section>
            );
          }

          // Decisoes: titulo da secao a esquerda; decisoes numeradas na coluna de conteudo.
          if (block.type === 'decisions') {
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  <div class={bodyClass}>
                    {block.intro && <p class="text-cold-gray leading-7 mb-10">{block.intro[lang]}</p>}
                    <ol class="space-y-14">
                      {block.items.map((item, i) => (
                        <li>
                          <h3 class={`${itemTitle} mb-4`}>{item.title[lang]}</h3>
                          <div class="space-y-6">
                            {item.paragraphs[lang].map((p) => (
                              <p class="text-cold-gray leading-7">{p}</p>
                            ))}
                          </div>
                          {item.table && (
                            <dl class="mt-6 space-y-3 text-cold-gray">
                              {item.table.rows.map((row) => (
                                <div class="rounded-2xl bg-lilac-blue px-6 py-5 md:px-8 md:py-6">
                                  <dt class="mb-2 text-blue-gray text-sm font-medium tracking-wide">{row[0][lang]}</dt>
                                  {row.slice(1).map((cell) => (
                                    <dd class="leading-7">{cell[lang]}</dd>
                                  ))}
                                </div>
                              ))}
                            </dl>
                          )}
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </section>
            );
          }

          // Telas agrupadas por fluxo, com numeracao e legenda.
          if (block.type === 'screens') {
            screenCounter = 0;
            return (
              <section>
                <div class="flex flex-col md:flex-row md:justify-between">
                  <Hs class={headingClass}>{block.heading[lang]}</Hs>
                  {block.intro && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{block.intro[lang]}</p>}
                </div>
                <div class="mt-16 space-y-24 md:space-y-32">
                  {block.groups.map((group, gi) => (
                    <div>
                      <div class="mb-8 flex flex-col gap-3 md:flex-row md:justify-between">
                        <h3 class={`${itemTitle} md:basis-1/3 xl:basis-1/2`}>
                          <span class="text-blue-gray font-light mr-3">{String.fromCharCode(65 + gi)}</span>
                          {group.label[lang]}
                        </h3>
                        {group.text && <p class={`text-cold-gray leading-7 ${bodyClass}`}>{group.text[lang]}</p>}
                      </div>
                      <div class={`grid gap-x-6 gap-y-12 ${group.layout === 'two' ? 'md:grid-cols-2' : ''}`}>
                        {group.screens.map((s) => {
                          screenCounter += 1;
                          const n = String(screenCounter).padStart(2, '0');
                          return (
                            <figure class={s.wide ? 'md:col-span-2' : undefined}>
                              <a
                                href={s.image.src.src}
                                target="_blank"
                                rel="noopener"
                                class="block rounded-3xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cold-gray"
                                aria-label={`${s.title ? s.title[lang] : s.image.alt[lang]} (${enlarge}, ${newTab})`}
                              >
                                <Image src={s.image.src} alt={s.image.alt[lang]} class="rounded-3xl" loading="lazy" data-reveal />
                              </a>
                              {(s.title || s.caption) && (
                                <figcaption class="mt-4 max-w-[60ch]">
                                  <p class={`${eyebrow} mb-1`}>{screenLabel} {n}</p>
                                  {s.title && <p class="text-cold-gray leading-7">{s.title[lang]}</p>}
                                  {s.caption && <p class="text-blue-gray leading-6 mt-1">{s.caption[lang]}</p>}
                                </figcaption>
                              )}
                            </figure>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            );
          }

          return null;
        })
      }
    </main>

    {
      neighbours.length > 0 && (
        <nav class="mb-24 mt-8" aria-label={navLabel}>
          <ul class={`grid gap-3 ${neighbours.length > 1 ? 'md:grid-cols-2' : ''}`}>
            {neighbours.map(({ p, label, dir }) => (
              <li class={dir === 'prev' ? 'md:order-1' : 'md:order-2'}>
                <a
                  href={hrefFor(p)}
                  class="group flex h-full flex-col rounded-3xl bg-lilac-blue p-4 transition-colors hover:bg-[#E3EDFB] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cold-gray motion-reduce:transition-none md:p-5"
                >
                  <span class="block overflow-hidden rounded-2xl">
                    <Image
                      src={p.image}
                      alt=""
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      loading="lazy"
                    />
                  </span>
                  <span class={`mt-5 flex items-start gap-4 px-2 pb-2 ${dir === 'prev' ? 'flex-row' : 'flex-row-reverse justify-between'}`}>
                    <span
                      aria-hidden="true"
                      class={`mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cold-gray text-white transition-transform duration-300 ease-out motion-reduce:transition-none ${dir === 'prev' ? 'group-hover:-translate-x-1' : 'group-hover:translate-x-1'}`}
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        {dir === 'prev' ? (
                          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
                        ) : (
                          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                        )}
                      </svg>
                    </span>
                    <span class="flex-1">
                      <span class={`${eyebrow} block mb-2`}>
                        {label} · {typeof p.client === 'string' ? p.client : p.client[lang]}
                      </span>
                      <span class={`block ${itemTitle}`}>{p.headline[lang]}</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </Container>

  <!-- Voltar ao topo: aparece depois que a pessoa rola para baixo do titulo -->
  <a href="#case-top" class="back-to-top" aria-label={backToTopLabel} title={backToTopLabel} data-back-to-top>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</Layout>

<style>
  /* Progresso de leitura: aparece so em navegadores com animacao ligada a rolagem. */
  .read-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 60;
      background: theme('colors.cold-gray');
      transform-origin: 0 50%;
      transform: scaleX(0);
      animation: read-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Botao de voltar ao topo, fixo no canto inferior direito. */
  .back-to-top {
    position: fixed;
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: theme('colors.cold-gray');
    color: white;
    box-shadow: 0 6px 20px rgb(55 70 100 / 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.3s;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .back-to-top:hover svg {
    transform: translateY(-2px);
  }

  .back-to-top svg {
    transition: transform 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top svg {
      transition: none;
    }
  }

  .case-marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 4rem, black calc(100% - 4rem), transparent);
  }

  .case-marquee__track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: case-marquee 60s linear infinite;
  }

  /* Pausa apenas onde existe ponteiro: no toque isso travaria a animacao. */
  @media (hover: hover) and (pointer: fine) {
    .case-marquee:hover .case-marquee__track,
    .case-marquee:focus-within .case-marquee__track {
      animation-play-state: paused;
    }
  }

  .case-marquee.is-paused .case-marquee__track {
    animation-play-state: paused;
  }

  .case-marquee__item {
    height: 22rem;
    width: auto;
    max-width: none;
    flex-shrink: 0;
  }

  @keyframes case-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* metade do percurso, porque a lista aparece duas vezes */
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  /* Quem pediu menos movimento no sistema ve uma faixa estatica e rolavel. */
  @media (prefers-reduced-motion: reduce) {
    .case-marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .case-marquee__track {
      animation: none;
    }
  }
</style>

<script>
  // Os videos substituem GIFs: tocam sozinhos, mas ficam parados
  // para quem pediu menos movimento nas preferencias do sistema.
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!semMovimento) {
    for (const video of document.querySelectorAll('video[data-auto-video]')) {
      if (video instanceof HTMLVideoElement) {
        video.play().catch(() => {});
      }
    }
  }

  // Voltar ao topo: mostra o botao quando o titulo sai da tela.
  const topo = document.getElementById('case-top');
  const voltar = document.querySelector('[data-back-to-top]');
  if (topo && voltar instanceof HTMLAnchorElement) {
    new IntersectionObserver(([entry]) => {
      voltar.classList.toggle('is-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(topo);

    // Leva o foco ao titulo, para quem navega pelo teclado continuar do inicio.
    voltar.addEventListener('click', (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: semMovimento ? 'auto' : 'smooth' });
      topo.focus({ preventScroll: true });
    });
  }

  // Botao para pausar e retomar o carrossel, que se move sozinho.
  for (const botao of document.querySelectorAll('[data-marquee-toggle]')) {
    const faixa = botao.parentElement?.querySelector('[data-marquee]');
    if (!(botao instanceof HTMLButtonElement) || !faixa) continue;
    botao.addEventListener('click', () => {
      const pausado = faixa.classList.toggle('is-paused');
      botao.setAttribute('aria-pressed', String(pausado));
      botao.textContent = pausado ? botao.dataset.labelPlay ?? '' : botao.dataset.labelPause ?? '';
    });
  }
</script>