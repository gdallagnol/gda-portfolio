---
import photo from '@assets/img-gabi.webp';
import logoNimble from '@assets/companies/nimble.webp';
import logoNomade from '@assets/companies/nomade.webp';
import logoMatriz from '@assets/companies/matriz.webp';
import logoDf2 from '@assets/companies/df2.webp';
import logoOrium from '@assets/companies/orium.webp';
import bgGlass2 from '@assets/background-glass-2.webp';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { about } from '@i18n/about';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = about[lang];

const experience = [
  { role: c.roles.service, logo: logoNimble, company: 'Nimble Evolution', period: `2025 — ${c.period.current}` },
  { role: c.roles.product, logo: logoNomade, company: 'Nômade Code', period: '2021 — 2025' },
  { role: c.roles.designerAd, logo: logoMatriz, company: 'Agência Matriz', period: '2018 — 2021' },
  { role: c.roles.designer, logo: logoDf2, company: 'DF2 Design', period: '2017 — 2018' },
  { role: c.roles.ad, logo: logoOrium, company: 'Orium Data-Driven Marketing', period: '2016 — 2017' },
];
---

<div class="bg-lilac-blue text-blue-black py-20 mt-20">
  <div class="container mx-auto px-6 lg:px-14 2xl:px-36">
    <div class="hidden xl:block xl:relative">
      <img src={bgGlass2.src} alt="" class="xl:h-[40rem] xl:absolute xl:inset-0 xl:top-[28rem]" />
    </div>

    <section class="xl:flex">
      <div class="xl:basis-1/2">
        <h2 class="text-2xl">{t('about.title')}</h2>

        <div class="max-w-80">
          <img src={photo.src} alt={c.photoAlt} class="my-10 max-h-72" />
          <p class="text-blue-black text-xl font-light my-10">{t('about.greeting')}</p>
        </div>
      </div>
      <div class="xl:basis-1/2">
        <div class="space-y-5">
          {c.paragraphs.map((paragraph) => <p class="text-blue-black font-light leading-7 max-w-[68ch]">{paragraph}</p>)}
        </div>

        <div class="mt-10 space-y-10">
          <p class="text-blue-black text-2xl">{t('about.help')}</p>

          {
            c.services.map((service) => (
              <div class="space-y-2">
                <p class="text-blue-black text-xl">{service.title}</p>
                <p class="text-blue-black font-light leading-7 max-w-[68ch]">{service.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="my-28 space-y-7 xl:flex xl:space-y-0 xl:mt-96 xl:mb-48">
      <h3 class="text-2xl xl:basis-1/2">{t('about.experience')}</h3>

      <div class="space-y-10 xl:basis-1/2">
        {
          experience.map((item) => (
            <div class="space-y-5">
              <p class="text-xl font-light">{item.role}</p>
              <div class="flex gap-5 items-center">
                <img src={item.logo.src} alt="" class="h-8 hidden md:block" />
                <p class="font-light text-blue-gray">
                  {item.company} ({item.period})
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-20 space-y-7 xl:flex xl:space-y-0">
      <h3 class="text-2xl xl:basis-1/2">{t('about.education')}</h3>

      <div class="space-y-10 xl:basis-1/2">
        {
          c.education.map((item) => (
            <div class="space-y-5">
              <p class="text-xl font-light">{item.title}</p>
              <p class="font-light text-blue-gray">{item.years}</p>
              <p class="font-light text-blue-gray">{item.school}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</div>