---
import Layout from '@layouts/Layout.astro';
import About from '@components/About.astro';
import Container from '@components/Container.astro';
import { Tabs } from '@components/Tabs';
import backgroundGlass from '@assets/background-glass.webp';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={lang === 'pt' ? "Gabi Dall'Agnol | Service Designer e UX Researcher" : "Gabi Dall'Agnol | Service Designer and UX Researcher"}>
  <Container>
    <div class="hidden md:block md:relative">
      <img
        src={backgroundGlass.src}
        alt=""
        class="md:absolute md:top-14 md:left-52 lg:top-48 lg:left-96 xl:top-24 xl:left-[34rem] 2xl:left-[40rem]"
      />
    </div>
    <section class="mb-12">
      <h1
        class="text-[2rem] leading-[2.5rem] text-cold-gray font-light md:text-[2.5rem] md:leading-[3.5rem] lg:text-[4rem] lg:leading-[5rem]"
      >
        {t('home.title.1')} <span class="whitespace-nowrap">{t('home.title.2')}</span>
        <br />
        <span class="text-blue-gray">{t('home.title.3')}</span>
      </h1>
    </section>

    <main class="relative md:mt-28">
      <Tabs client:load lang={lang} />
    </main>
  </Container>

  <About />
</Layout>