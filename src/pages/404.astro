---
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import arrow from '@assets/arrow.svg';
import bgGlass2 from '@assets/background-glass-3.webp';
import { getLangFromUrl, useTranslations, localizePath } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);
const pageTitle = lang === 'pt' ? 'Página não encontrada | Gabi Dall\'Agnol' : 'Page not found | Gabi Dall\'Agnol';
---

<!-- Sem rodape: a imagem decorativa transborda e cobriria o footer. -->
<Layout title={pageTitle} noindex hideFooter>
  <Container>
    <h1 class="text-2xl lg:text-6xl text-cold-gray font-light mb-16">
      {t('404.title.1')} <span class="xl:whitespace-nowrap">{t('404.title.2')}</span>
      <span class="xl:whitespace-nowrap">{t('404.title.3')}</span>
    </h1>

    <a class="bg-cold-gray rounded-full text-white p-5 items-center inline-flex gap-8" href={homeHref}>
      {t('404.back')}
      <img src={arrow.src} alt="" />
    </a>

    <div class="hidden xl:block xl:relative">
      <img src={bgGlass2.src} alt="" aria-hidden="true" class="xl:h-[40rem] xl:absolute xl:right-0 xl:top-[-15rem]" />
    </div>
  </Container>
</Layout>